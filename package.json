{
  "name": "warhammer-warband",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "data": "node scripts/build-data.mjs",
    "rule": "node scripts/rule.mjs",
    "rules:text": "node scripts/rules-text.mjs",
    "rules:check": "vitest run src/engine/rulesData.test.ts src/engine/rulesStatus.test.ts src/engine/army.test.ts src/engine/allies.test.ts src/engine/layers.test.ts src/engine/layoutSymmetry.test.ts src/rules-engine/stratTarget.test.ts",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
