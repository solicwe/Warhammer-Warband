   "stratagems": [
    {
     "name": "INFERNAL FUSILLADE",
     "cp": 1,
     "text": "WHEN: Your Shooting phase.\nTARGET: One Thousand Sons Psyker unit from your army that has not been selected to shoot this phase.\nEFFECT: Until the end of the phase, all inferno bolt pistols, inferno boltguns, inferno combi-bolters and inferno combi-weapons equipped by models in your unit have the [PSYCHIC] ability."
    },
    {
     "name": "UNWAVERING PHALANX",
     "text": "WHEN: Your opponent\u2019s Charge phase, just after an enemy unit ends a Charge move.\nTARGET: One Rubric Marines unit from your army within Engagement Range of that enemy unit.\nEFFECT: Until the end of the turn, attacks that target your unit with a S greater than your unit\u2019s T have -1 to wound rolls."
    }
   ]
  }
